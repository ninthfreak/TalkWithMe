future*.md
Personas/
chatrooms/

# Live config: your rooms, personas and server URLs. The app reads and
# writes config/ and never touches the tracked *.yaml files at the repo
# root, which stay as shipped starting points. Keeping the root files
# tracked is deliberate: untracking them made `git pull` try to delete
# files people had edited locally, which git refuses ("Your local changes
# would be overwritten by merge").
config/
# Backup/variant copies alongside the root files.
personas.yaml.*
chatrooms.yaml.*
settings.yaml.*
testsetup.sh
restore.sh
